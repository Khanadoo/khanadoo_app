generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  OWNER
  ADMIN
}

enum PropertyType {
  ROOM
  PG
  HOUSE
  APARTMENT
}

enum PropertyPurpose {
  RENT
  SALE
}

enum PropertyStatus {
  AVAILABLE
  RENTED
  SOLD
}

enum EnquiryStatus {
  PENDING
  CONTACTED
  NEGOTIATING
  CLOSED
  CANCELLED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  phone     String?

  role      Role     @default(USER)
  status    UserStatus @default(ACTIVE)

  enquiries Enquiry[]

  properties Property[] @relation("OwnerProperties")

  refreshTokens RefreshToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  expiresAt DateTime
}

model Property {
  id String @id @default(uuid())

  title       String
  description String?

  type         PropertyType
  purpose      PropertyPurpose
  status       PropertyStatus @default(AVAILABLE)

  price Float

  city     String
  locality String
  address  String

  bedrooms  Int?
  bathrooms Int?
  area      Float?

  imageUrls String[]

  ownerId String
  owner   User @relation("OwnerProperties", fields: [ownerId], references: [id])

  featured Boolean @default(false)
  verified Boolean @default(false)

  isActive Boolean @default(true)

  enquiries Enquiry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Enquiry {
  id String @id @default(uuid())

  userId String
  user User @relation(fields: [userId], references: [id])

  propertyId String
  property Property @relation(fields: [propertyId], references: [id])

  phone   String
  message String?

  status EnquiryStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}